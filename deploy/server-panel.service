[Unit]
Description=Server Panel
After=network-online.target
Wants=network-online.target

[Service]
User=panel
Group=panel
WorkingDirectory=/opt/server-panel
EnvironmentFile=/etc/server-panel.env
ExecStart=/usr/bin/node /opt/server-panel/server/index.js
Restart=on-failure
RestartSec=3
PrivateTmp=true
# NOTE: if you use --manage-local, do not add NoNewPrivileges=true — it would disable the sudo
# rules the panel uses on this machine. (Remote servers are managed over SSH and are unaffected.)

[Install]
WantedBy=multi-user.target
